# พอร์ตของ backend (ตรงกับ backend จริง: 4000)
PORT=4000
# shift_code ที่ไม่ร่วมสุ่ม (director / internship) — ค่าใน mock เป็นค่าสมมติ
EXCLUDE_SHIFT_CODES=THAI-ODIR,THAI-OINT
# (ไม่บังคับ) ไฟล์รายชื่อ gid ที่ไม่ร่วมสุ่ม บรรทัดละ 1 gid
EXCLUDE_GIDS_FILE=exclude_gids.txt
# รูปพนักงานแบบ cache: image-cache/<gid>.txt (data URL) — ถ้าไม่มีใช้ avatar mock
IMAGE_CACHE_DIR=image-cache
OUTPUT_DIR=output
# off = ไม่สร้าง avatar ปลอม (จำลองรูปหาย → frontend ใช้รูป placeholder)
# MOCK_AVATAR=off
